{
  "manifest_version": 3,
  "name": "CineVerse Companion",
  "version": "0.4.0",
  "description": "Transmet a CineVerse la progression reelle des lecteurs video autorises, y compris 2embed et ses miroirs.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": ["activeTab", "scripting", "webNavigation"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.vidzy.org/*",
    "https://*.vidzy.cc/*",
    "https://*.uqload.is/*",
    "https://*.uqload.com/*",
    "https://*.uqload.co/*",
    "https://*.uqload.to/*",
    "https://*.voe.sx/*",
    "https://*.kokoflix.lol/*",
    "https://*.kakaflix.lol/*",
    "https://*.filmoon.sx/*",
    "https://*.netu.tv/*",
    "https://*.waaw.to/*",
    "https://*.vidlink.pro/*",
    "https://*.multiembed.mov/*",
    "https://streamingnow.mov/*",
    "https://*.streamingnow.mov/*",
    "https://abyssplayer.com/*",
    "https://*.abyssplayer.com/*",
    "https://stevenfamilyedge.com/*",
    "https://*.stevenfamilyedge.com/*",
    "https://2embed.online/*",
    "https://*.2embed.online/*",
    "https://2embed.stream/*",
    "https://*.2embed.stream/*",
    "https://2embed.cc/*",
    "https://*.2embed.cc/*",
    "https://2embed.to/*",
    "https://*.2embed.to/*",
    "https://2embed.ru/*",
    "https://*.2embed.ru/*",
    "https://2embed.vip/*",
    "https://*.2embed.vip/*",
    "https://2e.to/*",
    "https://*.2e.to/*",
    "https://vibuxer.com/*",
    "https://*.vibuxer.com/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Etat du suivi CineVerse",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["cineverse-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.vidzy.org/*",
        "https://*.vidzy.cc/*",
        "https://*.uqload.is/*",
        "https://*.uqload.com/*",
        "https://*.uqload.co/*",
        "https://*.uqload.to/*",
        "https://*.voe.sx/*",
        "https://*.kokoflix.lol/*",
        "https://*.kakaflix.lol/*",
        "https://*.filmoon.sx/*",
        "https://*.netu.tv/*",
        "https://*.waaw.to/*",
        "https://*.vidlink.pro/*",
        "https://*.multiembed.mov/*",
        "https://streamingnow.mov/*",
        "https://*.streamingnow.mov/*",
        "https://abyssplayer.com/*",
        "https://*.abyssplayer.com/*",
        "https://stevenfamilyedge.com/*",
        "https://*.stevenfamilyedge.com/*",
        "https://2embed.online/*",
        "https://*.2embed.online/*",
        "https://2embed.stream/*",
        "https://*.2embed.stream/*",
        "https://2embed.cc/*",
        "https://*.2embed.cc/*",
        "https://2embed.to/*",
        "https://*.2embed.to/*",
        "https://2embed.ru/*",
        "https://*.2embed.ru/*",
        "https://2embed.vip/*",
        "https://*.2embed.vip/*",
        "https://2e.to/*",
        "https://*.2e.to/*",
        "https://vibuxer.com/*",
        "https://*.vibuxer.com/*"
      ],
      "js": ["media-observer.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ]
}