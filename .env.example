TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# Public origin used by social metadata. Keep the local default for local use.
# CINEVERSE_BASE_URL=https://cineverse.example.com

# Optional outside Docker. Defaults to ./data in the project directory.
# CINEVERSE_DATA_DIR=/absolute/path/to/cineverse-data

# FStream announces its current temporary domain from this stable address.
FSTREAM_INDEX_URL=https://fstream.info/
# Optional emergency override. Leave empty to follow FSTREAM_INDEX_URL.
# FSTREAM_BASE_URL=https://fs16.lol
# Comma-separated HTTPS origins accepted in addition to https://fs<number>.lol.
FSTREAM_ALLOWED_ORIGINS=

# Optional exact host extensions for player URLs returned by a stream source.
# Example: {"voe":["new-voe.example"],"uqload":["new-uqload.example"]}
CINEVERSE_PLAYER_HOST_ALLOWLIST_JSON={}

# Optional trusted wrapper domains (2Embed and mirrors). Defaults to known
# 2embed domains: 2embed.online/stream/cc/to/ru/vip, 2e.to, vibuxer.com,
# streamingnow.mov.
CINEVERSE_TRUSTED_WRAPPER_HOSTS_JSON=["streamingnow.mov","2embed.online","www.2embed.online","2embed.stream","www.2embed.stream","2embed.cc","2embed.to","2embed.ru","2embed.vip","2e.to","vibuxer.com"]

# Optional: replace the demo player with lawful/self-hosted providers.
# Template placeholders: {tmdbId}, {mediaType}, {title}, {language}, {season}, {episode}
# Example provider: 2Embed (https://www.2embed.online)
# Supports both TMDB numeric IDs and IMDb IDs (with tt prefix)
# CINEVERSE_EMBED_PROVIDERS_JSON=[{"id":"2embed","name":"2Embed","template":"https://www.2embed.online/embed/{tmdbMediaType}/{tmdbId}{seasonEpisodePath}","supportsTracking":false,"supportsLanguage":false,"priority":1}]
