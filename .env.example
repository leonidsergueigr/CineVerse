TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# Optional outside Docker. Defaults to ./data in the project directory.
# CINEVERSE_DATA_DIR=/absolute/path/to/cineverse-data

# FStream announces its current temporary domain from this stable address.
FSTREAM_INDEX_URL=https://fstream.info/
# Optional emergency override. Leave empty to follow FSTREAM_INDEX_URL.
# FSTREAM_BASE_URL=https://fs16.lol
# Comma-separated HTTPS origins accepted in addition to https://fs<number>.lol.
FSTREAM_ALLOWED_ORIGINS=

# Optional exact host extensions for player URLs returned by a stream source.
# Example: {"voe":["new-voe.example"],"uqload":["new-uqload.example"]}
CINEVERSE_PLAYER_HOST_ALLOWLIST_JSON={}

# Optional: replace the demo player with lawful/self-hosted providers.
# Template placeholders: {tmdbId}, {mediaType}, {title}, {language}, {season}, {episode}
CINEVERSE_EMBED_PROVIDERS_JSON=[{"id":"cineverse-demo","name":"CineVerse Demo","template":"/api/demo-player?tmdbId={tmdbId}&mediaType={mediaType}&title={title}&language={language}&season={season}&episode={episode}","supportsTracking":true,"supportsLanguage":true,"priority":1}]
